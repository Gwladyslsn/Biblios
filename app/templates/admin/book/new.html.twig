{% extends 'base.html.twig' %}

{% block title %}Ajout de livre{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 4em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Ajout d'un livre</h1>

    <div class="”w-50" m-auto”>
			{{form_start(form)}}
			    {{form_row(form.title, {label: 'Titre'})}}
                {{form_row(form.isbn, {label: 'isbn'})}}
                {{form_row(form.cover, {label: 'Couverture'})}}
                {{form_row(form.editedAt, {label: 'Date d\'édition'})}}
                {{form_row(form.plot, {label: 'Synopsis'})}}
                {{form_row(form.pageNumber, {label: 'Nombre de page'})}}
                {{form_row(form.status, {label: 'Statut'})}}
                {{form_row(form.editor, {label: 'Editeur'})}}
                {{form_row(form.author, {label: 'Auteur'})}}
                <button type="submit" class="btn btn-primary">Envoyer</button>
			{{form_end(form)}}
		</div>
</div>
{% endblock %}
