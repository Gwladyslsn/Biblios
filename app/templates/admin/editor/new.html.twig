{% extends 'base.html.twig' %}

{% block title %}Ajout d'éditeur{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 4em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

	<div class="example-wrapper">
		<h1>Ajout d'éditeur</h1>
		<div class="”w-50" m-auto”>
			{{form_start(form)}}
			    {{form_row(form.name, {label: 'Nom de l\'éditeur'})}}
                {{form_row(form.books, {label: 'Livres'})}}
                <button type="submit" class="btn btn-primary">Envoyer</button>
			{{form_end(form)}}
		</div>
    </div>
{% endblock %}
